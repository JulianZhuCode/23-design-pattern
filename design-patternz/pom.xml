<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zhuzz</groupId>
    <artifactId>design-patternz</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- 项目元数据（用于 Maven Central 检索与 SEO）
         Project metadata (for Maven Central indexing and SEO) -->
    <name>23 Design Patterns (Java)</name>
    <description>Interactive Java 21 lab for all 23 GoF design patterns: documentation, runnable cases and a graphical interface.</description>
    <url>https://github.com/JulianZhuCode/23-design-pattern</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <commonmark.version>0.23.0</commonmark.version>
        <javafx.version>21.0.2</javafx.version>
        <junit.version>5.11.3</junit.version>
        <!-- OpenJFX 平台 classifier：无 classifier 的 jar 是空占位，类与本地库都在 classifier jar 中
             OpenJFX platform classifier: classifier-less jars are empty placeholders -->
        <javafx.classifier>win</javafx.classifier>
    </properties>

    <dependencies>
        <!-- Markdown 解析与渲染（README 展示）
             Markdown parsing & rendering for README display -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <!-- GFM 表格扩展，README 中的表格依赖它
             GFM tables extension, required by tables in the README files -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>${commonmark.version}</version>
        </dependency>

        <!-- JavaFX WebView：渲染 Markdown + Mermaid 图（README 展示）
             JavaFX WebView renders Markdown + Mermaid diagrams for README display
             注意：OpenJFX 的类与本地库都打包在带平台 classifier 的 jar 中，需显式声明全部所需模块
             Note: OpenJFX ships classes + natives in the platform-classified jars only -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.classifier}</classifier>
        </dependency>

        <!-- 单元测试：JUnit 5
             Unit tests: JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 依据操作系统切换 JavaFX 平台 classifier（Windows 用默认值 win）
         按 os.arch 细分 Mac：aarch64 → mac-aarch64，x86_64 → mac
         Selects the JavaFX platform classifier by OS (Windows uses the default 'win')
         Mac is split by os.arch: aarch64 → mac-aarch64, x86_64 → mac -->
    <profiles>
        <profile>
            <id>javafx-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <javafx.classifier>linux</javafx.classifier>
            </properties>
        </profile>
        <profile>
            <id>javafx-mac-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <javafx.classifier>mac</javafx.classifier>
            </properties>
        </profile>
        <profile>
            <id>javafx-mac-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <javafx.classifier>mac-aarch64</javafx.classifier>
            </properties>
        </profile>
    </profiles>

    <build>
        <resources>
            <!-- 将源码目录下的 README（*.md）与本地化输出资源（*.properties）复制到 classpath，
                 供运行时读取。输出资源与案例代码同包放置，按包路径解析。
                 Copy README (*.md) and localized output resources (*.properties) under the
                 source tree onto the classpath. Output resources are co-located with each
                 demo package and resolved by package path. -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.md</include>
                    <include>**/*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- 运行 JUnit 5 单元测试
                 Runs JUnit 5 unit tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>